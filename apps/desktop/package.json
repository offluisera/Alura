{
  "name": "alura",
  "version": "1.0.3",
  "description": "Alura Desktop Application",
  "author": "Alura",
  "main": "main.js",
  "scripts": {
    "prestart": "node -e \"const fs = require('fs'); fs.rmSync('./ui', {recursive: true, force: true}); fs.cpSync('../web/dist', './ui', {recursive: true});\"",
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "build:portable": "node build-portable.js",
    "prebuild": "node -e \"const fs = require('fs'); fs.rmSync('./ui', {recursive: true, force: true}); fs.cpSync('../web/dist', './ui', {recursive: true});\""
  },
  "build": {
    "appId": "com.alura.app",
    "productName": "Alura",
    "artifactName": "setup_alura.${ext}",
    "win": {
      "target": "nsis",
      "artifactName": "setup_alura.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Alura",
      "artifactName": "setup_alura.${ext}"
    },
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "preload-call.js",
      "incoming-call.html",
      "notification.html",
      "updater.html",
      "icon.png",
      "ui/**/*"
    ]
  },
  "devDependencies": {
    "electron": "^29.1.0",
    "electron-builder": "^24.12.0",
    "@electron/packager": "^20.3.0"
  }
}

# ── Alura Phoenix Backend — Variáveis de Ambiente de Produção ──

# Porta do servidor HTTP / WebSocket
PORT=4000

# Domínio público apontado pelo Cloudflare / Nginx
PHX_HOST=api.alura.net.br

# Forçar inicialização do servidor Phoenix
PHX_SERVER=true

# Chave secreta de 64 bytes para assinatura de sessões e tokens
# Gere uma com: mix phx.gen.secret
SECRET_KEY_BASE=sua_chave_secreta_aqui_com_no_minimo_64_bytes_gerada_aleatoriamente

# Conexão com o PostgreSQL do Supabase
# Exemplo com o pooler do Supabase (porta 6543) ou conexão direta (5432):
DATABASE_URL=postgres://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?ssl=true

# Limite de conexões do pool Ecto (adequado para o VPS de 4 GB)
POOL_SIZE=10

# Supabase API (para autenticação de JWTs e Storage)
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=sua_anon_key_do_supabase
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_do_supabase
